# Mapbox — booking address suggestions (server) + static map cutout (client).
# Use a pk. public token. URL-restrict it to brxs.ca / www.brxs.ca in the Mapbox dashboard.
# Do not commit a live token. Add both to the Vercel project for www.brxs.ca (bricks-site).
# MAPBOX_ACCESS_TOKEN is the server-side geocoding token; NEXT_PUBLIC_MAPBOX_TOKEN is inlined
# into the browser for the Static Images cutout (same pk. is fine).
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase — shared project rbywjnnctjglhcdemnnj. NEXT_PUBLIC_* are safe to ship
# to the browser (anon/publishable key by design); SUPABASE_SERVICE_ROLE_KEY is
# server-only and must never be
# exposed with a NEXT_PUBLIC_ prefix.
# Required for booking/contact: no hardcoded key/URL fallbacks in source.
# Missing NEXT_PUBLIC_SUPABASE_* → BookingWizard error UI / contact API 503.
NEXT_PUBLIC_SUPABASE_URL=https://rbywjnnctjglhcdemnnj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://rbywjnnctjglhcdemnnj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bricks OS API base URL (bookings, coverage).
BRICKS_OS_API_URL=

# Newsletter (src/lib/newsletter, /api/newsletter/*). Subscribers live in Resend
# contacts, segment "Newsletter". Double opt-in; signed links (HMAC), no database.
RESEND_API_KEY=              # sending (restricted key is fine)
NEWSLETTER_RESEND_KEY=       # full-access key for contacts (falls back to RESEND_INBOUND_API_KEY)
NEWSLETTER_SECRET=           # long random string; signs confirm/unsubscribe links. Never rotate casually: old unsubscribe links stop working.
NEWSLETTER_SEGMENT_ID=d51b56c0-a701-41db-9a71-c36b08c33470
NEWSLETTER_ALERT_TO=         # default raph@brxs.ca
NEWSLETTER_POSTAL_ADDRESS=   # CASL mailing address; default is Bricks Group · 6330 Montevideo Road, Mississauga, ON L5N 3V2, Canada
NEWSLETTER_BASE_URL=https://www.brxs.ca  # pin on prod; preview Workers may omit (code falls back to request host when BRICKS_SITE_PREVIEW=1)

# --- Supabase Edge Function secrets (NOT Next.js/Vercel env vars) ---
# The functions in supabase/functions/*/index.ts run on Supabase, not Vercel,
# and read their config via `Deno.env.get(...)`, set with
# `supabase secrets set KEY=value` (or the Supabase dashboard) -- never via
# this .env.example / Vercel project settings. Listed here only so this repo
# has one place documenting every secret the booking flow depends on:
#   STRIPE_SECRET_KEY        - create-checkout (Stripe Checkout Session creation)
#   STRIPE_WEBHOOK_SECRET    - stripe-webhook (signature verification -- the
#                              function fails closed with a 500 if this is unset,
#                              it does NOT process unverified webhooks)
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY - auto-injected by Supabase, every function
#   APP_URL                  - create-checkout success/cancel redirect + wallet domains
#   CAL_KEY                  - stripe-webhook (Cal.com booking on paid checkout; optional)
#   DISPATCH_API_URL         - stripe-webhook (Bricks GO job intake; falls back to
#                              https://dispatch-api.brxs.ca)
#   INTERNAL_API_KEY / INTERNAL_API_KEYS - stripe-webhook (X-Internal-Api-Key sent to Dispatch)
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER - stripe-webhook (owner SMS; optional)
#   RESEND_API_KEY           - stripe-webhook / newsletter-signup (owner + subscriber email; optional)
#   POSTMARK_SERVER_TOKEN / POSTMARK_API_TOKEN - newsletter-signup (optional)
#   BRXS_FORWARD_PHONE       - stripe-webhook (owner SMS destination; has a hardcoded fallback)
#   NOTIFY_EMAIL             - stripe-webhook (owner email destination; falls back to raphael@brxs.ca)

# App-level www gate (middleware). When set/non-empty, visitors need the
# bricks_www_gate cookie (set via /gate → POST /api/gate). Leave empty for local dev.
WWW_SITE_GATE_PASSWORD=

# Demo invite magic links (HMAC). Falls back to WWW_SITE_GATE_PASSWORD when unset.
# Used by src/lib/demo-invite.ts + POST /api/demo/invite.
DEMO_INVITE_SECRET=
